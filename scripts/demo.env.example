# Copy to scripts/demo.env (gitignored) and fill in local values.
# Never commit passwords, tokens, tunnel credentials, or Sites secrets.

# --- Database (MySQL stays on the laptop; never exposed by the tunnel) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=questboard_presentation
# MYSQL_USER / MYSQL_PASSWORD come from .devcontainer/.env unless set here.

# Docker Compose / container that already publishes MySQL only on localhost.
DEMO_MYSQL_CONTAINER=test-app-mysql-container

# --- FastAPI (bound to loopback; phones reach it only via the HTTPS tunnel) ---
DEMO_API_HOST=127.0.0.1
DEMO_API_PORT=8010
# Optional override if Poetry's venv path differs on another laptop:
# DEMO_POETRY_PYTHON=/path/to/backend-api-…/bin/python

# Durable proof uploads for the presentation DB (preserved across restarts).
PROOF_MEDIA_DIR=

# --- Tunnel ---
# Prefer a named Cloudflare tunnel with a stable hostname (recommended).
# Leave DEMO_TUNNEL_HOSTNAME empty to use a quick tunnel (URL changes each start).
DEMO_TUNNEL_BIN=
# Absolute path to a cloudflared config that defines a named tunnel, e.g.:
#   tunnel: <id>
#   credentials-file: /path/to/<id>.json
#   ingress:
#     - hostname: api-demo.example.com
#       service: http://127.0.0.1:8010
#     - service: http_status:404
DEMO_CLOUDFLARED_CONFIG=
DEMO_TUNNEL_HOSTNAME=
# Fallback provider when no named config is set: cloudflared | ngrok
DEMO_TUNNEL_PROVIDER=cloudflared

# Optional ngrok settings (only if DEMO_TUNNEL_PROVIDER=ngrok)
# NGROK_AUTHTOKEN is read from the environment / ngrok config — do not put it here.
DEMO_NGROK_DOMAIN=

# --- Frontend (Sites) — used by scripts/build-sites-frontend.sh ---
# Public ChatGPT Sites origin after you publish (informational; not required to start API).
SITES_ORIGIN=
# Discussions stay off until Grove/access rules are independently accepted.
VITE_DISCUSSIONS_API=false
VITE_DISCUSSIONS_DEMO=false

# Classroom demo login aliases (admin / mod). Backend + Sites FE must both enable.
# Passwords live only in this gitignored file / ACCOUNTS.local.md — never commit them.
QUESTBOARD_CLASSROOM_DEMO=1
VITE_CLASSROOM_DEMO=true
# CLASSROOM_DEMO_ADMIN_PASSWORD=
# CLASSROOM_DEMO_MOD_PASSWORD=

# Only if Docker still publishes MySQL on 0.0.0.0 and you accept the risk temporarily:
# DEMO_ALLOW_NON_LOOPBACK_MYSQL=1
