# Copy this file to .env and restart `npm run dev` after changing it.
# The FastAPI routes are served at the root of the backend (for example /auth/login),
# so this is the backend origin without a path.
VITE_API_BASE_URL=http://localhost:8000

# Organizer/moderator requests and the admin page use the backend's role-request API
# (/role-requests, added with QB-30). Set this to anything other than true for a backend
# without it; those features are then shown as unavailable.
VITE_ROLE_REQUESTS_ENABLED=true
