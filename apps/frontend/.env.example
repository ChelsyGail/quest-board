# Copy this file to .env and restart `npm run dev` after changing it.
# The FastAPI routes are served at the root of the backend (for example /auth/login),
# so this is the backend origin without a path.
VITE_API_BASE_URL=http://localhost:8000

# Organizer/moderator requests and the admin page use the backend's role-request API
# (/role-requests, added with QB-30). Set this to anything other than true for a backend
# without it; those features are then shown as unavailable.
VITE_ROLE_REQUESTS_ENABLED=true

# Catalogue pages: Quests (discovery, details, join/RSVP), My items (list, publish, edit,
# participants), Create quest and Create event. They use /quests, /events, /items and
# /me/participations. Either flag turns them on; leave both unset for a backend without
# the catalogue API.
VITE_QUESTS_ENABLED=true
VITE_CATALOGUE_ENABLED=true

# Dev-only sample data for the quest pages. Ignored in production builds
# (import.meta.env.DEV). When true, quest pages never call the API and show a demo banner.
# Keep false to use the real backend.
VITE_QUESTS_DEMO=false

# Discussions / Quest Grove. Live API uses /discussions/* (migration 0021).
# Never enable both demo and API; live mode never falls back to demo after failure.
# For local live Grove/quest discussions: DEMO=false and API=true.
VITE_DISCUSSIONS_DEMO=false
VITE_DISCUSSIONS_API=false

# Classroom demo: allow Login aliases "admin" / "mod" (Sites presentation).
# Signup and password-change still require ≥12 character passwords.
# Backend must set QUESTBOARD_CLASSROOM_DEMO=1 and ensure presentation accounts.
VITE_CLASSROOM_DEMO=false

# Student proof. Demo = in-browser sample only (DEV). Live API = real
# POST /uploads, POST/GET /participations/{id}/submissions, GET /media/{id}.
# Never enable both; live mode never falls back to demo after a failure.
VITE_PROOFS_DEMO=false
VITE_PROOFS_API=false
# Moderator queue/approve/reject under /moderation/submissions.
# Enable only with a backend that implements those routes (e.g. PR #24).
VITE_MODERATION_API=false

# Achievements/rewards: GET /users/me/achievements, /rewards, /rewards/{id}/claims.
VITE_REWARDS_DEMO=false
VITE_REWARDS_API=false
