# Copy to a local .env (never commit real secrets). Loaded by your shell or Compose.
# The API process reads these via utilities/settings.py.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass
MYSQL_DATABASE=questboard_review

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Private proof blobs for LocalObjectStore (BE-37). Default if unset:
# apps/backend/var/proof-media (gitignored via var/).
# In deployment, point this at a persistent volume — do not rely on the
# .devcontainer workspace bind mount or `sleep infinity` as durable storage.
PROOF_MEDIA_DIR=

# Hours after which uploads not attached to a submission are deleted (BE-43).
# Run: make cleanup-uploads
UPLOAD_ABANDON_AFTER_HOURS=24
